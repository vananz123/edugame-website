# Supabase — copy file này thành .env.local rồi điền giá trị thật.
# KHÔNG commit .env.local. Chỉ file .env.example (placeholder) được commit.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# URL công khai của site (dùng cho SEO metadata/sitemap). Để trống khi dev → http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chỉ thêm khi thật sự cần thao tác đặc quyền phía server.
# KHÔNG bao giờ để lộ key này ra client code hoặc commit.
# SUPABASE_SERVICE_ROLE_KEY=